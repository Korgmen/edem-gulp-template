{
	"name": "edem-gulp-template",
	"version": "1.7.1",
	"private": true,
	"description": "Edem Template on ESM",
	"type": "module",
	"scripts": {
		"dev": "gulp",
		"build": "gulp build --build",
		"build:stage": "gulp build --build --env=stage",
		"font": "gulp font",
		"dev:deploy": "gulp --deploy",
		"deploy": "gulp deploy --build",
		"deploy:stage": "gulp deploy --build --env=stage",
		"demo:remove": "gulp demoRemove",
		"example:remove": "gulp exampleRemove",
		"lint": "pnpm lint:js && pnpm lint:scss && pnpm format:check && pnpm docs:check",
		"lint:js": "eslint .",
		"lint:scss": "stylelint \"src/scss/**/*.scss\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs:check": "node gulp/scripts/checkDocs.js"
	},
	"repository": "korgmen/edem-gulp-template",
	"keywords": [
		"gulp",
		"gulp template",
		"gulp layout",
		"easy layout"
	],
	"author": "Роман Лебедев (t.me/korgmen)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/korgmen/edem-gulp-template/issues"
	},
	"homepage": "https://github.com/korgmen/edem-gulp-template#readme",
	"engines": {
		"node": ">=24"
	},
	"browserslist": [
		"defaults"
	],
	"packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"browser-sync": "^3.0.4",
		"browserslist": "^4.29.0",
		"del": "^8.0.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"gulp": "^5.0.1",
		"gulp-file-include": "^2.3.0",
		"gulp-fonter": "^0.3.0",
		"gulp-html-minifier-terser": "^8.0.0",
		"gulp-if": "^3.0.0",
		"gulp-imagemin": "^9.2.0",
		"gulp-newer": "^1.4.0",
		"gulp-notify": "^5.0.0",
		"gulp-plumber": "^1.2.1",
		"gulp-rename": "^2.1.0",
		"gulp-sass": "^6.0.1",
		"gulp-svg-sprite": "^2.0.3",
		"gulp-svgmin": "^4.1.0",
		"gulp-ttf2woff2": "^5.0.0",
		"lightningcss": "^1.33.0",
		"picomatch": "^4.0.7",
		"plugin-error": "^2.0.1",
		"prettier": "^3.9.7",
		"sass": "^1.104.1",
		"ssh2-sftp-client": "^12.1.1",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"through2": "^5.0.11"
	},
	"dependencies": {
		"@caneara/iodine": "^8.5.0",
		"imask": "^7.6.1",
		"photoswipe": "^5.4.4",
		"swiper": "^14.2.0"
	},
	"pnpm": {
		"packageExtensions": {
			"ternary-stream@3": {
				"dependencies": {
					"ordered-read-streams": "^2.0.0"
				}
			}
		}
	}
}
