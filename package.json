{
	"name": "edem-gulp-template",
	"version": "1.4.0",
	"private": true,
	"description": "Edem Template on ESM",
	"type": "module",
	"scripts": {
		"dev": "gulp --no-experimental-require-module",
		"build": "gulp build --build --no-experimental-require-module",
		"build:stage": "gulp build --build --env=stage --no-experimental-require-module",
		"font": "gulp font --no-experimental-require-module",
		"dev:deploy": "gulp --deploy --no-experimental-require-module",
		"deploy": "gulp deploy --build --no-experimental-require-module",
		"deploy:stage": "gulp deploy --build --env=stage --no-experimental-require-module",
		"demo:remove": "gulp demoRemove --no-experimental-require-module",
		"example:remove": "gulp exampleRemove --no-experimental-require-module",
		"lint": "pnpm lint:js && pnpm lint:scss && pnpm format:check",
		"lint:js": "eslint .",
		"lint:scss": "stylelint \"src/scss/**/*.scss\"",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"repository": "korgmen/edem-gulp-template",
	"keywords": [
		"gulp",
		"gulp template",
		"gulp layout",
		"easy layout"
	],
	"author": "Роман Лебедев (t.me/korgmen)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/korgmen/edem-gulp-template/issues"
	},
	"homepage": "https://github.com/korgmen/edem-gulp-template#readme",
	"engines": {
		"node": ">=22"
	},
	"browserslist": [
		"defaults"
	],
	"packageManager": "pnpm@9.7.1+sha512.faf344af2d6ca65c4c5c8c2224ea77a81a5e8859cbc4e06b1511ddce2f0151512431dd19e6aff31f2c6a8f5f2aced9bd2273e1fed7dd4de1868984059d2c4247",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"browser-sync": "^3.0.4",
		"browserslist": "^4.28.9",
		"del": "^8.0.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"gulp": "^5.0.1",
		"gulp-file-include": "^2.3.0",
		"gulp-fonter": "^0.3.0",
		"gulp-html-minifier-terser": "^7.1.0",
		"gulp-if": "^3.0.0",
		"gulp-imagemin": "^9.2.0",
		"gulp-newer": "^1.4.0",
		"gulp-notify": "^5.0.0",
		"gulp-plumber": "^1.2.1",
		"gulp-rename": "^2.1.0",
		"gulp-sass": "^6.0.1",
		"gulp-svg-sprite": "^2.0.3",
		"gulp-svgmin": "^4.1.0",
		"gulp-ttf2woff2": "^5.0.0",
		"lightningcss": "^1.33.0",
		"picomatch": "^4.0.7",
		"plugin-error": "^2.0.1",
		"prettier": "^3.9.7",
		"sass": "^1.94.2",
		"ssh2-sftp-client": "^12.1.1",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"through2": "^4.0.2"
	},
	"dependencies": {
		"@caneara/iodine": "^8.5.0",
		"imask": "^7.6.1",
		"photoswipe": "^5.4.4",
		"swiper": "^12.0.3"
	},
	"pnpm": {
		"packageExtensions": {
			"ternary-stream@3": {
				"dependencies": {
					"ordered-read-streams": "^2.0.0"
				}
			}
		}
	}
}
