# Локальные настройки сборки и доступы для выгрузки на сервер по SFTP (pnpm dev:deploy / pnpm run deploy).
# Скопируйте этот файл в .env и заполните. Файл .env не коммитится.

DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USERNAME=

# Авторизация: SSH-ключ (рекомендуется) и/или пароль.
# Путь к приватному ключу в формате OpenSSH, ~ раскрывается в домашнюю папку (работает и на Windows).
DEPLOY_PRIVATE_KEY=~/.ssh/id_ed25519
DEPLOY_PASSPHRASE=
DEPLOY_PASSWORD=

# SHA256-отпечаток ключа сервера — защита от подмены сервера (особенно актуально при работе через VPN).
# Оставьте пустым при первом запуске: gulp покажет отпечаток сервера. Сверьте его с выводом команды
#   ssh-keyscan -p 22 ваш-хост | ssh-keygen -lf -
# (или с данными в панели хостинга) и впишите сюда, например SHA256:AbCdEf...
DEPLOY_HOST_FINGERPRINT=

# Порт локального dev-сервера (browser-sync), по умолчанию 3000.
SERVER_PORT=
